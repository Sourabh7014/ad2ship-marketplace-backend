// Ad2Ship Multi-Vendor Marketplace - Relational Database Schema
// Follows Product, Operations & Database Blueprint specification

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. Identity, Access & RBAC
// ==========================================

enum RoleEnum {
  admin
  seller
  user
}

model User {
  id              BigInt       @id @default(autoincrement())
  name            String
  email           String       @unique
  phone           String?      @unique
  passwordHash    String       @map("password_hash")
  role            RoleEnum     @default(user)
  emailVerifiedAt DateTime?    @map("email_verified_at")
  phoneVerifiedAt DateTime?    @map("phone_verified_at")
  status          Int          @default(0) @db.SmallInt // 0: active, 1: inactive
  softDelete      Int          @default(0) @map("soft_delete") @db.SmallInt // 0: false, 1: true
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at")
  deletedAt       DateTime?    @map("deleted_at")

  userRoles       UserRole[]
  sellerUsers     SellerUser[]
  refreshTokens   RefreshToken[]

  @@map("users")
}

model Role {
  id         BigInt           @id @default(autoincrement())
  code       String           @unique // ADMIN, SELLER_ADMIN, CATALOG_ADMIN, etc.
  name       String
  scopeType  String           @default("GLOBAL") @map("scope_type") // GLOBAL, SELLER
  status     Int              @default(0) @db.SmallInt // 0: active, 1: inactive
  softDelete Int              @default(0) @map("soft_delete") @db.SmallInt // 0: false, 1: true
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @default(now()) @updatedAt @map("updated_at")
  deletedAt  DateTime?        @map("deleted_at")

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          BigInt           @id @default(autoincrement())
  code        String           @unique // seller.read, seller.approve, catalog.create, etc.
  description String?
  status      Int              @default(0) @db.SmallInt // 0: active, 1: inactive
  softDelete  Int              @default(0) @map("soft_delete") @db.SmallInt // 0: false, 1: true
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime?        @map("deleted_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  id         BigInt    @id @default(autoincrement())
  userId     BigInt    @map("user_id")
  roleId     BigInt    @map("role_id")
  sellerId   BigInt?   @map("seller_id")
  status     Int       @default(0) @db.SmallInt // 0: active, 1: inactive
  softDelete Int       @default(0) @map("soft_delete") @db.SmallInt // 0: false, 1: true
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  seller Seller? @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, sellerId])
  @@map("user_roles")
}

model RolePermission {
  id           BigInt    @id @default(autoincrement())
  roleId       BigInt    @map("role_id")
  permissionId BigInt    @map("permission_id")
  status       Int       @default(0) @db.SmallInt // 0: active, 1: inactive
  softDelete   Int       @default(0) @map("soft_delete") @db.SmallInt // 0: false, 1: true
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id         BigInt    @id @default(autoincrement())
  userId     BigInt    @map("user_id")
  tokenHash  String    @map("token_hash")
  device     String?
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  status     Int       @default(0) @db.SmallInt // 0: active, 1: inactive
  softDelete Int       @default(0) @map("soft_delete") @db.SmallInt // 0: false, 1: true
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ==========================================
// 2. Seller Organization, KYC & Profile
// ==========================================

model Seller {
  id               BigInt    @id @default(autoincrement())
  legalName        String    @map("legal_name")
  displayName      String    @map("display_name")
  slug             String    @unique
  email            String    @unique
  phone            String
  onboardingStatus Int       @default(1) @map("onboarding_status") @db.SmallInt // 1: DRAFT, 2: SUBMITTED, 3: UNDER_REVIEW, 4: NEEDS_CORRECTION, 5: APPROVED, 6: REJECTED
  onboardingFee    Decimal   @default(0.00) @map("onboarding_fee") @db.Decimal(10, 2)
  businessType     String?   @map("business_type") @db.VarChar(50)
  category         String?   @map("category") @db.VarChar(100)
  pan              String?   @map("pan") @db.VarChar(20)
  gstin            String?   @map("gstin") @db.VarChar(20)
  riskStatus       String    @default("NORMAL") @map("risk_status") // NORMAL, MEDIUM, HIGH
  status           Int       @default(0) @db.SmallInt // 0: active, 1: inactive
  softDelete       Int       @default(0) @map("soft_delete") @db.SmallInt // 0: false, 1: true
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  sellerUsers      SellerUser[]
  documents        SellerDocument[]
  addresses        SellerAddress[]
  bankAccounts     SellerBankAccount[]
  onboardingEvents SellerOnboardingEvent[]
  sellerBrands     SellerBrand[]
  sellerCategories SellerCategory[]
  brandRequests    BrandRequest[]
  categoryRequests CategoryRequest[]
  listings         SellerListing[]
  userRoles        UserRole[]
  warehouses       Warehouse[]

  @@map("sellers")
}

model SellerUser {
  id         BigInt    @id @default(autoincrement())
  sellerId   BigInt    @map("seller_id")
  userId     BigInt    @map("user_id")
  sellerRole String    @default("OWNER") @map("seller_role") // OWNER, CATALOG_OPERATOR, INVENTORY_OPERATOR, ORDER_OPERATOR, FINANCE
  status     Int       @default(0) @db.SmallInt // 0: active, 1: inactive
  softDelete Int       @default(0) @map("soft_delete") @db.SmallInt // 0: false, 1: true
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sellerId, userId])
  @@map("seller_users")
}

model SellerDocument {
  id                 BigInt    @id @default(autoincrement())
  sellerId           BigInt    @map("seller_id")
  documentType       String    @map("document_type") // PAN, GSTIN, CIN, CANCELLED_CHEQUE, ADDRESS_PROOF, TRADEMARK
  documentNumber     String?   @map("document_number")
  fileKey            String    @map("file_key")
  verificationStatus String    @default("PENDING") @map("verification_status") // PENDING, VERIFIED, REJECTED
  expiryDate         DateTime? @map("expiry_date")
  rejectionReason    String?   @map("rejection_reason")
  reviewerId         BigInt?   @map("reviewer_id")
  status             Int       @default(0) @db.SmallInt // 0: active, 1: inactive
  softDelete         Int       @default(0) @map("soft_delete") @db.SmallInt // 0: false, 1: true
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@map("seller_documents")
}

model SellerAddress {
  id            BigInt    @id @default(autoincrement())
  sellerId      BigInt    @map("seller_id")
  addressType   String    @map("address_type") // REGISTERED, PICKUP, RETURN, WAREHOUSE
  warehouseName String?   @map("warehouse_name") @db.VarChar(120)
  contactPerson String    @map("contact_person")
  contactPhone  String    @map("contact_phone")
  addressLine1  String    @map("address_line1")
  addressLine2  String?   @map("address_line2")
  city          String
  state         String
  pincode       String
  country       String    @default("IN")
  isDefault     Boolean   @default(false) @map("is_default")
  status        Int       @default(0) @db.SmallInt // 0: active, 1: inactive
  softDelete    Int       @default(0) @map("soft_delete") @db.SmallInt // 0: false, 1: true
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@map("seller_addresses")
}

model SellerBankAccount {
  id                     BigInt    @id @default(autoincrement())
  sellerId               BigInt    @map("seller_id")
  beneficiaryName        String    @map("beneficiary_name")
  bankName               String    @map("bank_name")
  accountNumberMasked    String    @map("account_number_masked")
  accountNumberEncrypted String?   @map("account_number_encrypted")
  accountType            String    @default("CURRENT") @map("account_type") @db.VarChar(20)
  ifscCode               String    @map("ifsc_code")
  verificationStatus     String    @default("PENDING") @map("verification_status") // PENDING, VERIFIED, REJECTED
  rejectionReason        String?   @map("rejection_reason")
  isPrimary              Boolean   @default(true) @map("is_primary")
  status                 Int       @default(0) @db.SmallInt // 0: active, 1: inactive
  softDelete             Int       @default(0) @map("soft_delete") @db.SmallInt // 0: false, 1: true
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt              DateTime? @map("deleted_at")

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@map("seller_bank_accounts")
}

model SellerOnboardingEvent {
  id         BigInt    @id @default(autoincrement())
  sellerId   BigInt    @map("seller_id")
  eventType  String    @map("event_type") // SUBMITTED, REVIEW_STARTED, APPROVED, REJECTED, CORRECTION_REQUESTED
  oldStatus  String?   @map("old_status")
  newStatus  String    @map("new_status")
  actorId    BigInt?   @map("actor_id")
  reason     String?
  status     Int       @default(0) @db.SmallInt // 0: active, 1: inactive
  softDelete Int       @default(0) @map("soft_delete") @db.SmallInt // 0: false, 1: true
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@map("seller_onboarding_events")
}

// ==========================================
// 3. Taxonomy & Brand Governance
// ==========================================

model Department {
  id         BigInt     @id @default(autoincrement())
  name       String     @db.VarChar(120)
  slug       String     @unique @db.VarChar(140)
  sortOrder  Int        @default(0) @map("sort_order")
  imageKey   String?    @map("image_key")
  status     Int        @default(0) @db.SmallInt // 0: active, 1: inactive
  softDelete Int        @default(0) @map("soft_delete") @db.SmallInt // 0: false, 1: true
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @default(now()) @updatedAt @map("updated_at")
  deletedAt  DateTime?  @map("deleted_at")

  categories Category[]

  @@map("departments")
}

model Category {
  id           BigInt     @id @default(autoincrement())
  departmentId BigInt?    @map("department_id")
  parentId     BigInt?    @map("parent_id")
  name         String     @db.VarChar(150)
  slug         String     @db.VarChar(170)
  level        Int        @default(1) @db.SmallInt // 1=Domain/Root, 2=Category, 3=Subcategory
  sortOrder    Int        @default(0) @map("sort_order")
  status       Int        @default(0) @db.SmallInt // 0: active, 1: inactive
  softDelete   Int        @default(0) @map("soft_delete") @db.SmallInt // 0: false, 1: true
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  department   Department? @relation(fields: [departmentId], references: [id])
  parent       Category?   @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children     Category[]  @relation("CategoryHierarchy")

  catalogProducts  CatalogProduct[]
  sellerCategories SellerCategory[]
  categoryRequests CategoryRequest[]

  @@unique([departmentId, parentId, slug])
  @@map("categories")
}

model Brand {
  id                 BigInt     @id @default(autoincrement())
  name               String     @db.VarChar(150)
  slug               String     @unique @db.VarChar(170)
  logoKey            String?    @map("logo_key")
  description        String?
  verificationStatus String     @default("VERIFIED") @map("verification_status") @db.VarChar(20) // PENDING, VERIFIED, REJECTED
  status             Int        @default(0) @db.SmallInt // 0: active, 1: inactive
  softDelete         Int        @default(0) @map("soft_delete") @db.SmallInt // 0: false, 1: true
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @default(now()) @updatedAt @map("updated_at")
  deletedAt          DateTime?  @map("deleted_at")

  catalogProducts CatalogProduct[]
  sellerBrands    SellerBrand[]

  @@map("brands")
}

model SellerBrand {
  id             BigInt    @id @default(autoincrement())
  sellerId       BigInt    @map("seller_id")
  brandId        BigInt    @map("brand_id")
  approvalStatus String    @default("PENDING") @map("approval_status") @db.VarChar(20) // PENDING, APPROVED, REJECTED
  approvedAt     DateTime? @map("approved_at")
  validUntil     DateTime? @map("valid_until")
  status         Int       @default(0) @db.SmallInt // 0: active, 1: inactive
  softDelete     Int       @default(0) @map("soft_delete") @db.SmallInt // 0: false, 1: true
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  brand  Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([sellerId, brandId])
  @@map("seller_brands")
}

model SellerCategory {
  id             BigInt    @id @default(autoincrement())
  sellerId       BigInt    @map("seller_id")
  categoryId     BigInt    @map("category_id")
  approvalStatus String    @default("PENDING") @map("approval_status") @db.VarChar(20) // PENDING, APPROVED, REJECTED
  approvedBy     BigInt?   @map("approved_by")
  approvedAt     DateTime? @map("approved_at")
  status         Int       @default(0) @db.SmallInt // 0: active, 1: inactive
  softDelete     Int       @default(0) @map("soft_delete") @db.SmallInt // 0: false, 1: true
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  seller   Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([sellerId, categoryId])
  @@map("seller_categories")
}

model BrandRequest {
  id                BigInt    @id @default(autoincrement())
  sellerId          BigInt    @map("seller_id")
  proposedBrandName String    @map("proposed_brand_name")
  evidenceKey       String?   @map("evidence_key")
  requestStatus     String    @default("PENDING") @map("request_status") // PENDING, APPROVED, REJECTED
  reviewerId        BigInt?   @map("reviewer_id")
  decisionReason    String?   @map("decision_reason")
  status            Int       @default(0) @db.SmallInt // 0: active, 1: inactive
  softDelete        Int       @default(0) @map("soft_delete") @db.SmallInt // 0: false, 1: true
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@map("brand_requests")
}

model CategoryRequest {
  id               BigInt    @id @default(autoincrement())
  sellerId         BigInt    @map("seller_id")
  parentCategoryId BigInt?   @map("parent_category_id")
  proposedName     String    @map("proposed_name")
  rationale        String?
  requestStatus    String    @default("PENDING") @map("request_status") // PENDING, APPROVED, REJECTED
  reviewerId       BigInt?   @map("reviewer_id")
  decisionReason   String?   @map("decision_reason")
  status           Int       @default(0) @db.SmallInt // 0: active, 1: inactive
  softDelete       Int       @default(0) @map("soft_delete") @db.SmallInt // 0: false, 1: true
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  seller         Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  parentCategory Category? @relation(fields: [parentCategoryId], references: [id])

  @@map("category_requests")
}

// ==========================================
// 4. Catalog, Variants & Seller Listings
// (Separating Canonical Product from Seller Offer)
// ==========================================

model CatalogProduct {
  id            BigInt    @id @default(autoincrement())
  brandId       BigInt    @map("brand_id")
  categoryId    BigInt    @map("category_id")
  title         String    @db.VarChar(250)
  description   String?   @db.Text
  styleCode     String?   @map("style_code") @db.VarChar(100)
  attributes    Json      @default("{}")
  catalogStatus String    @default("DRAFT") @map("catalog_status") @db.VarChar(24) // DRAFT, VALIDATION_FAILED, ACTIVE, PAUSED, ARCHIVED
  status        Int       @default(0) @db.SmallInt // 0: active, 1: inactive
  softDelete    Int       @default(0) @map("soft_delete") @db.SmallInt // 0: false, 1: true
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  brand    Brand            @relation(fields: [brandId], references: [id])
  category Category         @relation(fields: [categoryId], references: [id])
  variants ProductVariant[]

  @@map("catalog_products")
}

model ProductVariant {
  id               BigInt    @id @default(autoincrement())
  catalogProductId BigInt    @map("catalog_product_id")
  variantCode      String    @map("variant_code") @db.VarChar(120)
  barcode          String?   @db.VarChar(80)
  attributes       Json      @default("{}") // size, color, shade, pack_size, etc.
  status           Int       @default(0) @db.SmallInt // 0: active, 1: inactive
  softDelete       Int       @default(0) @map("soft_delete") @db.SmallInt // 0: false, 1: true
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  catalogProduct CatalogProduct  @relation(fields: [catalogProductId], references: [id], onDelete: Cascade)
  sellerListings SellerListing[]

  @@unique([catalogProductId, variantCode])
  @@map("product_variants")
}

model SellerListing {
  id               BigInt    @id @default(autoincrement())
  sellerId         BigInt    @map("seller_id")
  productVariantId BigInt    @map("product_variant_id")
  sellerSku        String    @map("seller_sku") @db.VarChar(120)
  mrp              Decimal   @db.Decimal(12, 2)
  sellingPrice     Decimal   @map("selling_price") @db.Decimal(12, 2)
  currency         String    @default("INR") @db.Char(3)
  condition        String    @default("NEW") @db.VarChar(20)
  approvalStatus   String    @default("PENDING") @map("approval_status") @db.VarChar(24) // PENDING, APPROVED, REJECTED
  listingStatus    String    @default("DRAFT") @map("listing_status") @db.VarChar(20) // DRAFT, ACTIVE, PAUSED, OUT_OF_STOCK, ARCHIVED
  status           Int       @default(0) @db.SmallInt // 0: active, 1: inactive
  softDelete       Int       @default(0) @map("soft_delete") @db.SmallInt // 0: false, 1: true
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  seller         Seller             @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  productVariant ProductVariant     @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  inventory      InventoryBalance[]

  @@unique([sellerId, sellerSku])
  @@map("seller_listings")
}

model Warehouse {
  id         BigInt    @id @default(autoincrement())
  sellerId   BigInt?   @map("seller_id")
  name       String    @db.VarChar(120)
  code       String    @unique @db.VarChar(60)
  status     Int       @default(0) @db.SmallInt // 0: active, 1: inactive
  softDelete Int       @default(0) @map("soft_delete") @db.SmallInt // 0: false, 1: true
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  seller    Seller?            @relation(fields: [sellerId], references: [id])
  inventory InventoryBalance[]

  @@map("warehouses")
}

model InventoryBalance {
  id              BigInt    @id @default(autoincrement())
  sellerListingId BigInt    @map("seller_listing_id")
  warehouseId     BigInt    @map("warehouse_id")
  onHand          Int       @default(0) @map("on_hand")
  reserved        Int       @default(0)
  damaged         Int       @default(0)
  safetyStock     Int       @default(0) @map("safety_stock")
  status          Int       @default(0) @db.SmallInt // 0: active, 1: inactive
  softDelete      Int       @default(0) @map("soft_delete") @db.SmallInt // 0: false, 1: true
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  sellerListing SellerListing @relation(fields: [sellerListingId], references: [id], onDelete: Cascade)
  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([sellerListingId, warehouseId])
  @@map("inventory_balances")
}

model ZoneMapping {
  id             Int     @id @default(autoincrement())
  partnerId      Int?    @map("partner_id")
  courierPartner String? @map("courier_partner") @db.VarChar
  city           String? @db.VarChar
  state          String? @db.VarChar
  hasCod         String? @map("has_cod") @db.VarChar
  hasDg          String? @map("has_dg") @db.VarChar
  hasPrepaid     String? @map("has_prepaid") @db.VarChar
  hasReverse     String? @map("has_reverse") @db.VarChar
  pickerZone     String? @map("picker_zone") @db.VarChar
  pincode        String? @db.VarChar
  routingCode    String? @map("routing_code") @db.VarChar
  codLimit       String? @map("cod_limit") @db.VarChar

  @@map("zone_mapping")
}
